# Neo Health MCP server — environment variables
#
# Copy this file to .env (gitignored) for local development.
# Production values are set as Railway env vars.

# ============================================================================
# REQUIRED — set all four
# ============================================================================

# Where the server keeps its local clone of the claude-config repo.
# Railway: a path inside your mounted volume (e.g., /data/claude-config).
# Local:   any path; the server clones into it on first start if empty.
VAULT_PATH=/data/claude-config

# Bearer-token auth. Comma-separated <label>:<token> pairs.
# Generate each token (pick one):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Labels appear in server logs only; never returned to clients.
# Required when MCP_TRANSPORT=http; ignored for stdio.
MCP_TOKENS=curator:<paste-32-hex-token>,boss:<paste-32-hex-token>

# Which transport to start.
#   http  = production / Railway. Listens on MCP_PORT for HTTPS clients.
#   stdio = local dev only. Reads/writes JSON-RPC on stdio.
MCP_TRANSPORT=http

# Port for the http transport. Ignored when MCP_TRANSPORT=stdio.
MCP_PORT=4000

# ============================================================================
# REPO ACCESS — fine-grained Personal Access Token via HTTPS
# ============================================================================
# The server clones claude-config on first start and pulls every 5 min.
# Generate the PAT at https://github.com/settings/personal-access-tokens:
#   - Resource owner:        neohealth-org (NOT your personal account)
#   - Repository access:     only select → claude-config
#   - Permissions → Contents: Read-only (Metadata auto-required)
# Replace `github_pat_YOUR_TOKEN` with the actual token. The literal
# "x-access-token" stays as-is — that's GitHub's HTTPS auth convention.
VAULT_REPO_URL=https://x-access-token:github_pat_YOUR_TOKEN@github.com/neohealth-org/claude-config.git

# ============================================================================
# OPTIONAL — defaults are sensible; only set to override
# ============================================================================

# How often to git-pull (milliseconds). Default 300000 (5 min). 0 = disable.
# VAULT_PULL_INTERVAL_MS=300000

# Glob restricting which vault files the MCP exposes. Default: all .md.
# Set this to exclude specific paths, e.g.:
#   MCP_EXPOSE_GLOB=**/*.md,!**/internal/**
# MCP_EXPOSE_GLOB=**/*.md
